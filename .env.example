# Copy to .env (git-ignored; never commit it). docker compose reads it.
DB_PASSWORD=change-me            # Postgres superuser "app"
APP_DB_PASSWORD=change-me
NEO4J_PASSWORD=change-me         # at least 8 characters; read once, when the volume is first created
PG_ADMIN_PASSWORD=change-me      # the sg_admin login that scripts/create_roles.sql creates
PG_READONLY_PASSWORD=change-me   # the sg_readonly login (runs every generated query)

# Keys for the providers named in config.yml (embedding and llm sections). Set only the ones you use;
# an empty value counts as set, so leave the others out rather than blank.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# VOYAGE_API_KEY=
