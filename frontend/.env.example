# Copy to .env.local. Both are optional.
# Where the API runs (uvicorn schemagraph.api.main:app). Leave unset for http://localhost:8000.
# VITE_API_URL=http://localhost:8000
# Use the sample data in src/mocks instead of the API. In this mode a question that starts with
# mock:invalid_sql, mock:no_schema, mock:bad or mock:unavailable shows that failure.
# VITE_USE_MOCKS=true
